#!name = 移动学工 · 我的申请发起学生请假
#!desc = 在「移动学工」事务待办的「我的申请」列表顶部插入一条「学生请假申请」入口，点击直接进入请假申请表单（新建态）。纯本地响应改写，不产生任何写请求，不改动服务器数据。
#!author = 
#!homepage = 
#!loon_version = 3.5.1(983)
#!tag = 教务,移动学工
#!type = normal

[Argument]
enabled = switch,true,tag=启用插件,desc=关闭后完全不再注入任何行
lcid = input,"61c48fff-73b8-47d7-b3ca-01ace5fd9a5b",tag=流程定义ID,desc=学生请假申请的 lcid。抓包实测值，一般不需要改
title = input,"学生请假申请",tag=卡片标题,desc=显示在卡片第一行
timeText = input,"未发起",tag=申请时间行,desc=卡片第二行「申请时间：」后面的文字。该文案由前端模板写死，无法整行去掉
nodeText = input,"点击本行开始填写",tag=当前节点行,desc=卡片第三行「当前节点：」后面的文字。留空则该行不显示
debug = switch,false,tag=调试日志,desc=在 Loon 日志里输出注入详情与跳过原因

[Script]
response if ${url} ~= /^https:\/\/ydxy\.gzpt\.edu\.cn:6870\/ydxg\/api\/sm-mobile\/processCenter\/queryBpmApplyedProcess/ && ${response.status} == 200 then script("ydxy_leave_entry.js", {${enabled}, ${lcid}, ${title}, ${timeText}, ${nodeText}, ${debug}}) with enable=${enabled}, tag=我的申请-请假入口, timeout=20, requires_body=true, debug=${debug}

[Mitm]
hostname = ydxy.gzpt.edu.cn
